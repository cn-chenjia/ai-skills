{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.xiaoqi/runtime/codex-hook.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.xiaoqi/runtime/codex-hook.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.xiaoqi/runtime/codex-hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.xiaoqi/runtime/codex-hook.mjs\""
          }
        ]
      }
    ]
  }
}
